.DS_Store
node_modules/
*.log

# Personal Claude Code config; impeccable regenerates this on install/update.
# Shared hooks live in .claude/settings.json.
.claude/settings.local.json

# Impeccable: runtime artifacts and personal config. Only the shared design
# sidecar and live config are tracked.
.impeccable/*
!.impeccable/design.json
!.impeccable/live/
.impeccable/live/*
!.impeccable/live/config.json
