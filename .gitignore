.DS_Store
node_modules/
*.log

# Personal Claude Code config; impeccable regenerates this on install/update.
# Shared hooks live in .claude/settings.json.
.claude/settings.local.json

# Impeccable: runtime artifacts and personal config. config.json is the
# shared, team-committed detector config (hook settings + sanctioned
# ignore-values); config.local.json is the gitignored per-developer
# override the skill's own docs describe — keep that one out.
.impeccable/*
!.impeccable/config.json
!.impeccable/design.json
!.impeccable/live/
.impeccable/live/*
!.impeccable/live/config.json
